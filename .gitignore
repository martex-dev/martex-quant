# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# The data lake — market data is regenerable from exchanges, never committed
# (anchored to repo root so src/trading_bot/data/ is NOT ignored)
/data/

# IDE / OS noise
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# Local environment files (API keys must never enter git)
.env

# Credentials. PROJECT_STATE has expected config/secrets/*.json since the July
# sprint, but nothing ignored the directory, so the first key written there
# would have been committed on the next `git add -A`. Ignore the whole tree,
# not individual filenames, so a new provider cannot reintroduce the hole.
config/secrets/
*.key
*.pem

# Research corpus vendored into the package by setup.py at build time.
# Generated from docs/ and config/; the originals are the source of truth.
/src/trading_bot/_bundle/
